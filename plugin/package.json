{
  "name": "@local/leetcode-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeetCode Lab — grind the full problem set with a real Java/C++ judge, 3D visual explainers, and an AI that animates the concept you're stuck on.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/**",
    "locale/*.json",
    "icon.svg",
    "web/**",
    "data/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
