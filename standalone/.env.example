# Copy to .env (local runs) or set as environment variables on your host.
PORT=8080

# AI tutor (OpenAI-compatible). Leave empty to run without the tutor —
# judging, tracing, variations infrastructure and walkthroughs all work regardless.
LLMAI_BASE_URL=https://api.openai.com/v1
LLMAI_API_KEY=
LLMAI_MODEL=gpt-4o-mini
